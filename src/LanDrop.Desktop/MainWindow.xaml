<Window x:Class="LanDrop.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="LAN Drop" Width="1020" Height="850" MinWidth="740" MinHeight="600"
 Background="#101416" Foreground="#F3F5F2" AllowDrop="True" Drop="FilesDropped">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,4,10,4"/><Setter Property="Background" Value="#C2F970"/><Setter Property="Foreground" Value="#162208"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinWidth" Value="200"/><Setter Property="Margin" Value="0,4,10,10"/></Style>
  <Style TargetType="GroupBox"><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="Foreground" Value="#F3F5F2"/><Setter Property="BorderBrush" Value="#303B3F"/></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel Margin="30">
  <DockPanel><ComboBox x:Name="LanguagePicker" DockPanel.Dock="Right" SelectionChanged="LanguageChanged" AutomationProperties.Name="LanguagePicker"/>
   <TextBlock Text="LAN DROP" FontSize="30" FontWeight="Bold" Foreground="#C2F970"/>
  </DockPanel>
  <TextBlock x:Name="Subtitle" FontSize="17"/>
  <TextBlock x:Name="Status" Foreground="#C2F970" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock x:Name="SecurityNote" Foreground="#D6B86A"/>
  <TextBlock x:Name="RecoveryNotice" Foreground="#D6B86A" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
  <GroupBox x:Name="ConnectionGroup">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock x:Name="NetworkLabel"/>
     <ComboBox x:Name="Network" DisplayMemberPath="Label" SelectedValuePath="Address" SelectionChanged="CertificateNetworkChanged" AutomationProperties.Name="Network interface"/>
     <CheckBox x:Name="SecureHttps" Checked="TransportChanged" Unchecked="TransportChanged" Margin="0,4,0,10" Foreground="#F3F5F2"/>
     <TextBlock x:Name="TransportStatus" Foreground="#D6B86A" AutomationProperties.LiveSetting="Polite"/>
     <StackPanel x:Name="CertificateControls">
      <TextBlock x:Name="CertificateLabel"/>
      <TextBox x:Name="CertificatePath" IsReadOnly="True" TextChanged="CertificateInputChanged" Margin="0,0,12,6" AutomationProperties.Name="HTTPS certificate path"/>
      <TextBlock x:Name="CertificatePasswordLabel"/>
      <PasswordBox x:Name="CertificatePassword" PasswordChanged="CertificateInputChanged" Margin="0,0,12,6" AutomationProperties.Name="Session-only certificate password"/>
      <WrapPanel><Button x:Name="ChooseCertificateButton" Click="ChooseCertificate"/><Button x:Name="GenerateCertificateButton" Click="GenerateCertificate"/><Button x:Name="CheckCertificateButton" Click="CheckCertificate"/></WrapPanel>
      <TextBlock x:Name="CertificateInfo" Foreground="#A5B1B5" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
     <Button x:Name="CopyCertificateButton" Click="CopyCertificateDetails" HorizontalAlignment="Left" IsEnabled="False"/>
     <Expander x:Name="CertificateHelpHeader" Margin="0,6,12,12"><TextBlock x:Name="CertificateHelp" Margin="0,10,0,0"/></Expander>
     <WrapPanel><Button x:Name="StartButton" Click="StartSharing"/><Button x:Name="StopButton" Click="StopSharing" IsEnabled="False"/><Button x:Name="DiagnosticsButton" Click="ShowDiagnostics"/><Button x:Name="ExportDiagnosticsButton" Click="ExportDiagnostics"/><Button x:Name="NewQrButton" Click="NewQr" IsEnabled="False"/></WrapPanel>
     <TextBlock x:Name="ExportDiagnosticsHelp" Foreground="#A5B1B5"/>
     <TextBlock x:Name="LinkText" Foreground="#A5B1B5" Margin="0,14,12,0"/>
     <Button x:Name="CopyLinkButton" Click="CopyLink" HorizontalAlignment="Left" IsEnabled="False"/>
    </StackPanel>
    <Image x:Name="QrImage" Grid.Column="1" Width="220" Height="220" Stretch="Uniform" AutomationProperties.Name="Pairing QR code"/>
   </Grid>
  </GroupBox>
  <GroupBox x:Name="FolderGroup"><StackPanel><TextBlock x:Name="FolderText"/><WrapPanel><Button x:Name="ChooseFolderButton" Click="ChooseFolder" IsEnabled="False"/><Button x:Name="OpenFolderButton" Click="OpenFolder" IsEnabled="False"/></WrapPanel></StackPanel></GroupBox>
  <GroupBox x:Name="DevicesGroup"><StackPanel x:Name="DevicesPanel"/></GroupBox>
  <GroupBox x:Name="OffersGroup"><StackPanel><TextBlock x:Name="OffersHelp"/><StackPanel x:Name="OffersPanel"/></StackPanel></GroupBox>
  <GroupBox x:Name="SendGroup"><StackPanel>
   <TextBlock x:Name="RecipientLabel"/><ComboBox x:Name="Recipient" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Recipient"/>
   <WrapPanel><Button x:Name="SendButton" Click="SelectFiles" IsEnabled="False"/><Button x:Name="RetryButton" Click="RetryFiles" IsEnabled="False"/><Button x:Name="ClearRetryButton" Click="ClearRetry" IsEnabled="False"/><Button x:Name="CancelButton" Click="CancelTransfer" IsEnabled="False"/><Button x:Name="HideButton" Click="HideToTray"/></WrapPanel>
   <TextBlock x:Name="RetryHelp" Foreground="#D6B86A"/>
   <ProgressBar x:Name="UploadProgress" Height="12" Maximum="100"/><TextBlock x:Name="ProgressText" Margin="0,10,0,0"/>
  </StackPanel></GroupBox>
  <GroupBox x:Name="FilesGroup"><StackPanel x:Name="FilesPanel"/></GroupBox>
  <GroupBox x:Name="TransfersGroup"><StackPanel><TextBlock x:Name="TransfersHelp"/><Button x:Name="TransferFolderButton" Click="OpenFolder" IsEnabled="False" HorizontalAlignment="Left"/><StackPanel x:Name="TransfersPanel"/></StackPanel></GroupBox>
  <TextBlock x:Name="VersionText" Foreground="#A5B1B5"/>
 </StackPanel></ScrollViewer>
</Window>
